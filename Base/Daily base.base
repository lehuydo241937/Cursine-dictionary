filters:
  and:
    - '!file.name.contains(".template")'
    - '!file.name.contains(".base")'
views:
  - type: table
    name: Table
    filters:
      and:
        - note["Created date"].format("YYYY-MM-DD") == this.file.name
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
